# local | production (escolhe o docker-compose.{APP_ENV}.yml)
APP_ENV=local
# Só no local: portas publicadas no host. Em produção os containers não publicam porta (ficam atrás do NPM).
APP_PORT=5180
API_PORT=8088
POSTGRES_HOST_PORT=5433
TIGERBEETLE_HOST_PORT=3001
# Produção — rede Docker do Nginx Proxy Manager (o container do front entra nela)
PROXY_NETWORK=nginx-proxy-manager

POSTGRES_DB=gomoney
POSTGRES_USER=gomoney
POSTGRES_PASSWORD=gomoney
