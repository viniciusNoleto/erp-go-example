# Build em dois estágios: o primeiro compila, o segundo só carrega o binário.
FROM golang:1.27-bookworm AS build
WORKDIR /src
# Copiar go.mod/go.sum antes do código deixa o download de dependências em
# cache enquanto elas não mudarem.
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# O cliente do TigerBeetle é uma biblioteca nativa ligada via cgo, por isso
# CGO_ENABLED=1 e uma imagem final com glibc (debian), não "scratch".
RUN CGO_ENABLED=1 go build -o /out/api ./cmd/api

FROM debian:bookworm-slim
COPY --from=build /out/api /usr/local/bin/api
EXPOSE 8080
ENTRYPOINT ["api"]
