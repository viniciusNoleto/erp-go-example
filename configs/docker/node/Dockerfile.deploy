FROM node:lts-alpine AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY package*.json ./
RUN npm ci

COPY . .

# `next build` com output: 'export' gera o site estático em ./out.
RUN npm run build

# O front é só estático: o nginx serve o build e repassa /api para o backend Go.
FROM nginx:1.27-alpine

COPY --from=builder /app/out /usr/share/nginx/html

EXPOSE 80
